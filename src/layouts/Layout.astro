---
const { title } = Astro.props;
const pageTitle = (title ? `${title} | ` : '') + 'Alex + Max Wedding 2026';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{ pageTitle }</title>
  </head>
  <body id="top">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --headerHeight: 4rem;
    --containerWidth: 576px;

    @media (min-width: 992px) {
      --containerWidth: 768px;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    text-align: left;
    font-family: system-ui, -apple-system, sans-serif;
    color: #000;
    background: #fcd1b5;
    background-attachment: fixed;
    font-size: 18px;
    line-height: 1;

    @media (min-width: 992px) {
      font-size: 20px;
    }
  }

  h1, h2, h3, h4, h5 {
    margin: 0 0 .5rem;
    line-height: 1.2;
  }

  h1, h2, h3 {
    font-family: serif;
    font-weight: 700;
  }

  h4, h5 {
    font-weight: 400;
  }

  h1 {
    font-size: 2.4rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.4rem;
  }

  h4 {
    font-size: 1.2rem;
  }

  p {
    margin: 0 0 .5rem;
    line-height: 1.4;
  }

  a {
    text-decoration: underline;
    color: inherit;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
