---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import PhotoDialog from '../components/PhotoDialog.astro';

const { title } = Astro.props;
const pageTitle = (title ? `${title} | ` : '') + 'Alex + Max Wedding 2026';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <PhotoGallery />
    <Footer />
    <PhotoDialog />
  </body>
</html>

<style is:global>
  :root {
    --headerHeight: 4.5rem;
    --containerWidth: 48rem;

    @media (width >= 64rem) {
      --containerWidth: 62rem;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: #fcd1b5;
    color: #333;
    font-family: system-ui, -apple-system, sans-serif;
    text-align: left;
  }

  h1, h2, h3, h4, h5 {
    margin: 0 0 .5rem;
    line-height: 1.2;
  }

  h1, h2, h3 {
    font-family: serif;
    font-weight: 700;
  }

  h4, h5 {
    font-weight: 400;
  }

  h1 {
    font-size: 2.2rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.4rem;
  }

  h4 {
    font-size: 1.2rem;
  }

  p {
    margin: 0 0 .5rem;
    line-height: 1.4;
  }

  a,
  button {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  a {
    text-decoration: underline;
    color: inherit;
  }

  input,
  select,
  button {
    font-size: 1rem;
  }

  button {
    touch-action: manipulation;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>

<script>
  document.body.addEventListener('touchstart', () => {});
</script>