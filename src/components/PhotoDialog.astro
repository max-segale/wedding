---
import Button from '@/components/Button.astro';
---

<dialog class="dialog">
  <div class="dialog-content">
    <div class="dialog-view">
      <img class="dialog-image" src="data:," alt="" />
    </div>
    <div class="controls">
      <div class="close-btn">
        <Button class="close-photo light" iconClass="close" label="Close image" />
      </div>
      <Button class="prev-photo light" iconClass="prev" label="Previous image" />
      <Button class="next-photo light" iconClass="next" label="Next image" />
    </div>
  </div>
</dialog>

<style>
  .dialog {
    width: 100vw;
    height: 100vh;
    max-width: 100dvw;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    padding: 0;
    background: transparent;

    &::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition: background-color .25s linear, backdrop-filter .5s linear;
    }

    &.is-open {
      &::backdrop {
        background: rgb(0 0 0 / .5);
        backdrop-filter: blur(.5rem);
      }
    }
  }

  .dialog-content {
    display: flex;
    flex-flow: column nowrap;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    @media (orientation: landscape) {
      flex-direction: row;
    }
  }

  .dialog-view {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    overflow: hidden;
  }

  .dialog-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity .25s linear;

    &.is-loaded {
      opacity: 1;
    }
  }

  .controls {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    gap: 1rem;
    padding: 1rem;
    @media (orientation: landscape) {
      flex-direction: column;
    }
  }

  .close-btn {
    margin: 0 auto 0 0;
    @media (orientation: landscape) {
      margin: 0 0 auto;
    }
  }
</style>

<script>
  const dialogPhoto = document.querySelector('.dialog') as HTMLDialogElement;
  const btnClose = dialogPhoto.querySelector('button.close-photo') as HTMLButtonElement;
  const btnPrev = dialogPhoto.querySelector('button.prev-photo') as HTMLButtonElement;
  const btnNext = dialogPhoto.querySelector('button.next-photo') as HTMLButtonElement;
  const dialogImage = dialogPhoto.querySelector('.dialog-image') as HTMLImageElement;
  const photoGallery = document.querySelector('.photo-gallery') as HTMLElement;
  const galleryItems = photoGallery.querySelectorAll('.gallery-item');
  let itemIndex = -1;

  const showPhoto = (callback?: () => void) => {
    const selectedItem = galleryItems[itemIndex] as HTMLElement;
    const { src, alt } = selectedItem.querySelector('img') as HTMLImageElement;
    if (dialogImage.src === src) {
      callback?.();
      return;
    };
    dialogImage.onload = callback || null;
    dialogImage.src = src;
    dialogImage.alt = alt;
  }

  const selectPhoto = () => {
    showPhoto(() => {
      dialogImage.classList.add('is-loaded');
    });
    dialogPhoto.showModal();
    requestAnimationFrame(() => {
      dialogPhoto.classList.add('is-open');
    });
  };

  const closePhoto = () => {
    dialogPhoto.classList.remove('is-open');
    dialogImage.classList.remove('is-loaded');
    dialogPhoto.close();
  };

  const nextItem = () => {
    itemIndex = (itemIndex + 1) % galleryItems.length;
    showPhoto();
  };

  const prevItem = () => {
    itemIndex = (itemIndex - 1 + galleryItems.length) % galleryItems.length;
    showPhoto();
  };

  btnClose.addEventListener('click', closePhoto);

  btnNext.addEventListener('click', nextItem);

  btnPrev.addEventListener('click', prevItem);

  dialogPhoto.addEventListener('keydown', ({ key }: KeyboardEvent) => {
    if (key === 'ArrowRight') nextItem();
    if (key === 'ArrowLeft') prevItem();
  });

  dialogPhoto.addEventListener('click', ({ target }: MouseEvent) => {
    const element = target as HTMLElement;
    if (!element.closest('button') && element.tagName !== 'IMG') {
      closePhoto();
    }
  });

  photoGallery.addEventListener('click', ({ target }: MouseEvent) => {
    const item = (target as HTMLElement).closest('.gallery-item') as HTMLElement;
    if (!item) return;
    itemIndex = Number(item.dataset.index || 0);
    selectPhoto();
  });
</script>
