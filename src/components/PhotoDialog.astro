---
import Button from '@/components/Button.astro';
---

<dialog class="dialog">
  <div class="dialog-content">
    <div class="dialog-view">
      <img class="dialog-image" src="data:," alt="" />
    </div>
    <div class="controls">
      <div class="close-btn">
        <Button class="close-photo light" iconClass="close" label="Close image" />
      </div>
      <Button class="prev-photo light" iconClass="prev" label="Previous image" />
      <Button class="next-photo light" iconClass="next" label="Next image" />
    </div>
  </div>
</dialog>

<style>
  .dialog {
    width: 100vw;
    height: 100vh;
    max-width: 100dvw;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    padding: 0;
    background: transparent;

    &::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition: background-color .25s linear, backdrop-filter .5s linear;
    }

    &.is-open {
      &::backdrop {
        background: rgb(0 0 0 / .5);
        backdrop-filter: blur(.5rem);
      }
    }
  }

  .dialog-content {
    display: flex;
    flex-flow: column nowrap;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    @media (--landscape) {
      flex-direction: row;
    }
  }

  .dialog-view {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    position: relative;
    overflow: hidden;

    &::before {
      content: '';
      display: block;
      position: absolute;
      z-index: 0;
      left: 50%;
      top: 50%;
      width: 3rem;
      height: 3rem;
      background: url('@/assets/icons/spinner.svg') center / contain no-repeat;
      opacity: .5;
      transform: translate(-50%, -50%) rotate(0deg);
      animation: image-spinner .5s linear infinite;
      transition: opacity .5s linear;
    }

    &.is-loaded {
      &::before {
        opacity: 0;
        animation-play-state: paused;
      }

      .dialog-image {
        opacity: 1;
      }
    }
  }

  .dialog-image {
    display: block;
    position: relative;
    z-index: 1;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity .25s linear;
  }

  .controls {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    gap: .5rem;
    padding: .5rem 1rem 1rem;
    @media (--landscape) {
      flex-direction: column;
      padding: 1rem 1rem 1rem .5rem;
    }
  }

  .close-btn {
    margin: 0 auto 0 0;
    @media (--landscape) {
      margin: 0 0 auto;
    }
  }

  @keyframes image-spinner {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
</style>

<script>
  const photoDialog = document.querySelector('.dialog') as HTMLDialogElement;
  const dialogView = photoDialog.querySelector('.dialog-view') as HTMLElement;
  const dialogImage = photoDialog.querySelector('.dialog-image') as HTMLImageElement;
  const btnClose = photoDialog.querySelector('button.close-photo') as HTMLButtonElement;
  const btnPrev = photoDialog.querySelector('button.prev-photo') as HTMLButtonElement;
  const btnNext = photoDialog.querySelector('button.next-photo') as HTMLButtonElement;
  const photoGallery = document.querySelector('.photo-gallery') as HTMLElement;
  const photoLinks = photoGallery.querySelectorAll<HTMLAnchorElement>('a');
  let itemIndex = -1;

  const showPhoto = () => {
    const { href } = photoLinks[itemIndex];
    if (dialogImage.src === href) return;
    dialogView.classList.remove('is-loaded');
    dialogImage.src = href;
  }

  const selectPhoto = () => {
    showPhoto();
    photoDialog.showModal();
    requestAnimationFrame(() => {
      photoDialog.classList.add('is-open');
    });
  };

  const closePhoto = () => {
    photoDialog.classList.remove('is-open');
    photoDialog.close();
  };

  const nextItem = () => {
    itemIndex = (itemIndex + 1) % photoLinks.length;
    showPhoto();
  };

  const prevItem = () => {
    itemIndex = (itemIndex - 1 + photoLinks.length) % photoLinks.length;
    showPhoto();
  };

  dialogImage.addEventListener('load', () => {
    dialogView.classList.add('is-loaded');
  });

  dialogImage.addEventListener('error', () => {
    nextItem();
  });

  btnClose.addEventListener('click', closePhoto);

  btnNext.addEventListener('click', nextItem);

  btnPrev.addEventListener('click', prevItem);

  photoDialog.addEventListener('keydown', ({ key }: KeyboardEvent) => {
    if (key === 'ArrowRight') nextItem();
    if (key === 'ArrowLeft') prevItem();
  });

  photoDialog.addEventListener('click', ({ target }: MouseEvent) => {
    const element = target as HTMLElement;
    if (!element.closest('button') && element.tagName !== 'IMG') {
      closePhoto();
    }
  });

  photoGallery.addEventListener('click', (event: MouseEvent) => {
    event.preventDefault();
    const target = event.target as HTMLElement;
    const item = target?.closest('a') as HTMLElement;
    if (!item) return;
    itemIndex = Number(item.dataset.index || 0);
    selectPhoto();
  });
</script>
