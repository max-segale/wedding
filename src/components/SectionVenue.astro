---
import { Image } from 'astro:assets';
import shawneeGroundsPhoto from '../assets/shawnee-grounds.jpeg';
import Section from './Section.astro';

const street = '100 Shawnee Inn Dr';
const city = 'Shawnee on Delaware, PA 18356';
const encodedAddress = encodeURIComponent(`${street}, ${city}`);
const url = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
---

<Section id="venue" title="Venue">
  <h3>The Shawnee Inn &amp; Golf Resort</h3>
  <div class="grid">
    <div>
      <p>The Shawnee Inn is a historic landmark resort on 250 acres along the Delaware River, situated in the Delaware Water Gap National Recreation Area.</p>
      <p>
        <a href={url} target="_blank">{street}<br />{city}</a>
      </p>
      <p>The Shawnee Inn has plenty of amenities and activities, including a 27-hole championship golf course, tennis, pickleball, volleyball, pool, spa, archery, fishing, boating, swimming, multiple on-site restaurants, and a craft brewery with live music.</p>
      <p>
        <em>For more info about the Shawnee Inn visit
          <a href="https://www.shawneeinn.com" target="_blank">shawneeinn.com</a>
        </em>
      </p>
    </div>
    <Image class="image" src={shawneeGroundsPhoto} alt="Shawnee Inn" />
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 100% 50%;

    @media (width >= 64rem) {
      aspect-ratio: 2 / 1;
    }
  }
</style>
