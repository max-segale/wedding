---
import { Image, getImage } from 'astro:assets';

const { src, galleryIndex, fullWidth = 1600, size = 'tall' } = Astro.props;
const thumbSizes = size === 'wide' || size === 'large'
  ? '(max-width: 31.999rem) calc(100vw - 32px), (max-width: 63.999rem) calc(50vw - 20px), calc(33.3333vw - 16px)'
  : '(max-width: 31.999rem) calc(50vw - 20px), (max-width: 63.999rem) calc(25vw - 14px), calc(16.6667vw - 12px)';
const fullImage = await getImage({
  src,
  width: fullWidth,
  widths: [440, 880, 1280, fullWidth],
  sizes: '100vw',
});
---

<a
  href={fullImage.src}
  role="button"
  data-index={galleryIndex}
  data-srcset={fullImage.srcSet.attribute}
  data-sizes="100vw"
  aria-label="View photo"
>
  <Image
    class="thumb"
    {src}
    alt=""
    widths={[408, 728, 816, 870]}
    sizes={thumbSizes}
    fetchpriority="low"
  />
</a>

<style>
  a,
  .thumb {
    display: block;
    width: 100%;
    height: 100%;
  }

  a {
    background: rgb(255 255 255 / .5);
    transition: transform .1s ease-out;

    &:active {
      transform: scale(0.9);
    }
  }

  .thumb {
    object-fit: cover;
    object-position: center;
    pointer-events: none;
    user-select: none;
  }
</style>
