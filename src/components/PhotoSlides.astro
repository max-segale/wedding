---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import { photoCollections } from '@/data/photos';

const { category } = Astro.props;
const imageFiles = photoCollections[category as keyof typeof photoCollections];
const images = await Promise.all(
  Object.values(imageFiles).map(importFn => importFn().then(module => module.default))
);
---

<photo-slideshow>
  <div class="photos">
    {
      images.map((img, index) => (
        <div class:list={['slide', { active: index === 0 }]} aria-hidden={index !== 0}>
          <Image
            src={img}
            alt="Photo booth"
            width={768}
            loading="eager"
          />
        </div>
      ))
    }
  </div>
  <div class="controls">
    <div class="play-btn">
      <Button class="play-slide dark" iconClass="play" label="Play photos" disabled />
    </div>
    <div class="prev-btn">
      <Button class="prev-slide dark" iconClass="prev" label="Previous photo" disabled />
    </div>
    <div class="next-btn">
      <Button class="next-slide dark" iconClass="next" label="Next photo" disabled />
    </div>
  </div>
</photo-slideshow>

<style>
  photo-slideshow {
    display: block;
    max-width: 48rem;
    margin: 0 auto;
  }

  .photos {
    display: grid;
    width: 100%;
    background: rgb(129, 26, 33);
    overflow: hidden;
  }

  .slide {
    grid-row: 1;
    grid-column: 1;
    width: 100%;
    opacity: 0;
    transition: opacity 250ms linear;

    &.active {
      z-index: 1;
      opacity: 1;
    }
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .controls {
    display: flex;
    flex-flow: row nowrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: .5rem;
    margin: .5rem auto;
  }

  .play-btn {
    margin-right: auto;
  }
</style>

<script>
  class PhotoSlideshow extends HTMLElement {
    activeIndex: number = 0;
    slideDuation: number = 500;
    slideInterval: number | null = null;
    slides: HTMLElement[] = [];
    playBtn: HTMLButtonElement | null = null;
    connectionController: AbortController | null = null;
    loggedImageFailures = new WeakSet<HTMLImageElement>();

    showSlide = (index: number) => {
      this.slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle('active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });
      this.activeIndex = index;
    }

    startPlayback = () => {
      if (this.slideInterval) return;
      this.slideInterval = window.setInterval(() => {
        this.showSlide((this.activeIndex + 1) % this.slides.length);
      }, this.slideDuation);
      this.playBtn?.classList.add('playing');
      this.playBtn?.setAttribute('aria-label', 'Pause photos');
    }

    stopPlayback = () => {
      if (!this.slideInterval) return;

      window.clearInterval(this.slideInterval);
      this.slideInterval = null;
      this.playBtn?.classList.remove('playing');
      this.playBtn?.setAttribute('aria-label', 'Play photos');
    }

    connectedCallback() {
      this.connectionController?.abort();
      const controller = new AbortController();
      this.connectionController = controller;

      const allSlides = [...this.querySelectorAll<HTMLElement>('.slide')];
      this.slides = allSlides;
      this.playBtn = this.querySelector('button.play-slide');
      const images = this.querySelectorAll<HTMLImageElement>('.slide img');
      const prevButton = this.querySelector<HTMLButtonElement>('button.prev-slide');
      const nextButton = this.querySelector<HTMLButtonElement>('button.next-slide');
      const imageLoads = [...images].map(image => {
        if (image.complete) {
          return Promise.resolve(image.naturalWidth > 0);
        }
        return new Promise<boolean>(resolve => {
          image.addEventListener('load', () => resolve(true), { once: true, signal: controller.signal });
          image.addEventListener('error', () => resolve(false), { once: true, signal: controller.signal });
        });
      });

      Promise.all(imageLoads).then(results => {
        if (!this.isConnected || this.connectionController !== controller) return;

        const loadedSlides: HTMLElement[] = [];
        results.forEach((loaded, index) => {
          const image = images[index];
          const slide = allSlides[index];
          if (loaded) {
            loadedSlides.push(slide);
            return;
          }

          slide.hidden = true;
          slide.classList.remove('active');
          slide.setAttribute('aria-hidden', 'true');
          if (!this.loggedImageFailures.has(image)) {
            console.error('Load Error', image.currentSrc || image.src);
            this.loggedImageFailures.add(image);
          }
        });

        this.slides = loadedSlides;
        if (this.slides.length === 0) return;
        this.showSlide(0);
        this.startPlayback();
        if (this.playBtn) this.playBtn.disabled = false;
        if (prevButton) prevButton.disabled = false;
        if (nextButton) nextButton.disabled = false;
      });

      this.playBtn?.addEventListener('click', () => {
        if (this.slideInterval) {
          this.stopPlayback();
          return;
        }
        this.startPlayback();
      }, { signal: controller.signal });

      prevButton?.addEventListener('click', () => {
        this.stopPlayback();
        this.showSlide((this.activeIndex - 1 + this.slides.length) % this.slides.length);
      }, { signal: controller.signal });

      nextButton?.addEventListener('click', () => {
        this.stopPlayback();
        this.showSlide((this.activeIndex + 1) % this.slides.length);
      }, { signal: controller.signal });
    }

    disconnectedCallback() {
      this.connectionController?.abort();
      this.connectionController = null;
      this.stopPlayback();
    }
  }

  customElements.define('photo-slideshow', PhotoSlideshow);
</script>
