---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import LoadingSpinner from '@/components/LoadingSpinner.astro';
import { photoCollections } from '@/data/photos';

const { category } = Astro.props;
const imageFiles = photoCollections[category as keyof typeof photoCollections];
const images = await Promise.all(
  Object.values(imageFiles).map(importFn => importFn().then(module => module.default))
);
---

<photo-slideshow>
  <div class="photos">
    <LoadingSpinner />
    {
      images.map(image => (
        <div class="slide" aria-hidden="true">
          <Image
            src={image}
            alt=""
            widths={[408, 768, 816, 1536]}
            sizes="(max-width: 800px) calc(100vw - 2rem), 768px"
            fetchpriority="low"
          />
        </div>
      ))
    }
  </div>
  <div class="controls">
    <div class="play-btn">
      <Button class="play-slide" iconClass="play" label="Play photos" disabled />
    </div>
    <div class="prev-btn">
      <Button class="prev-slide" iconClass="prev" label="Previous photo" disabled />
    </div>
    <div class="next-btn">
      <Button class="next-slide" iconClass="next" label="Next photo" disabled />
    </div>
  </div>
</photo-slideshow>

<style>
  photo-slideshow {
    display: block;
    max-width: 48rem;
    margin: 2rem auto;
  }

  .photos {
    display: grid;
    position: relative;
    width: 100%;
    background: rgb(129, 26, 33);
    overflow: hidden;

    &.is-ready {
      --loading-spinner-display: none;
    }
  }

  .slide {
    position: relative;
    grid-row: 1;
    grid-column: 1;
    width: 100%;
    opacity: 0;
    z-index: 0;
    transition: opacity 250ms linear;

    &.active {
      z-index: 1;
      opacity: 1;
    }
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }

  .controls {
    display: flex;
    flex-flow: row nowrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: .5rem;
    margin: .5rem auto;
  }

  .play-btn {
    margin-right: auto;
  }
</style>

<script>
  class PhotoSlideshow extends HTMLElement {
    activeIndex: number = 0;
    slideDuation: number = 500;
    slideInterval: number | null = null;
    slides: HTMLElement[] = [];
    playBtn: HTMLButtonElement | null = null;
    connectionController: AbortController | null = null;
    visibilityObserver: IntersectionObserver | null = null;
    loggedImageFailures = new WeakSet<HTMLImageElement>();

    showSlide = (index: number) => {
      if (this.activeIndex >= 0) {
        const prevSlide = this.slides[this.activeIndex];
        prevSlide.classList.remove('active');
        prevSlide.setAttribute('aria-hidden', 'true');
      }
      this.activeIndex = index;
      const nextSlide = this.slides[this.activeIndex];
      nextSlide.classList.add('active');
      nextSlide.setAttribute('aria-hidden', 'false');
    }

    startPlayback = () => {
      if (this.slideInterval) return;
      this.querySelector('.photos')?.classList.add('is-ready');
      this.slideInterval = window.setInterval(() => {
        this.showSlide((this.activeIndex + 1) % this.slides.length);
      }, this.slideDuation);
      this.playBtn?.classList.add('playing');
      this.playBtn?.setAttribute('aria-label', 'Pause photos');
    }

    stopPlayback = () => {
      if (!this.slideInterval) return;

      window.clearInterval(this.slideInterval);
      this.slideInterval = null;
      this.playBtn?.classList.remove('playing');
      this.playBtn?.setAttribute('aria-label', 'Play photos');
    }

    connectedCallback() {
      this.connectionController?.abort();
      this.visibilityObserver?.disconnect();
      const controller = new AbortController();
      this.connectionController = controller;

      const photos = this.querySelector<HTMLElement>('.photos');
      let isVisible = false;
      let imagesLoaded = false;
      const maybeStartPlayback = () => {
        if (!isVisible || !imagesLoaded || !this.isConnected || this.connectionController !== controller) return;
        this.visibilityObserver?.disconnect();
        this.visibilityObserver = null;
        this.startPlayback();
      };
      this.visibilityObserver = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting && entry.intersectionRatio >= 0.5)) return;
        isVisible = true;
        maybeStartPlayback();
      }, { threshold: 0.5 });
      if (photos) this.visibilityObserver.observe(photos);

      const allSlides = [...this.querySelectorAll<HTMLElement>('.slide')];
      this.slides = allSlides;
      this.playBtn = this.querySelector('button.play-slide');
      const images = this.querySelectorAll<HTMLImageElement>('.slide img');
      const prevButton = this.querySelector<HTMLButtonElement>('button.prev-slide');
      const nextButton = this.querySelector<HTMLButtonElement>('button.next-slide');
      const imageLoads = [...images].map(image => {
        if (image.complete) {
          return Promise.resolve(image.naturalWidth > 0);
        }
        return new Promise<boolean>(resolve => {
          image.addEventListener('load', () => {
            resolve(true);
          }, { once: true, signal: controller.signal });
          image.addEventListener('error', () => {
            resolve(false);
          }, { once: true, signal: controller.signal });
        });
      });

      Promise.all(imageLoads).then(results => {
        if (!this.isConnected || this.connectionController !== controller) return;

        const loadedSlides: HTMLElement[] = [];
        results.forEach((loaded, index) => {
          const image = images[index];
          const slide = allSlides[index];
          if (loaded) {
            loadedSlides.push(slide);
            return;
          }

          if (!this.loggedImageFailures.has(image)) {
            console.error('Load Error', image.currentSrc || image.src);
            this.loggedImageFailures.add(image);
          }
        });

        this.slides = loadedSlides;
        if (this.slides.length === 0) {
          this.visibilityObserver?.disconnect();
          this.visibilityObserver = null;
          return;
        }
        this.showSlide(0);
        imagesLoaded = true;
        maybeStartPlayback();
        if (this.playBtn) this.playBtn.disabled = false;
        if (prevButton) prevButton.disabled = false;
        if (nextButton) nextButton.disabled = false;
      });

      this.playBtn?.addEventListener('click', () => {
        if (this.slideInterval) {
          this.stopPlayback();
          return;
        }
        this.startPlayback();
      }, { signal: controller.signal });

      prevButton?.addEventListener('click', () => {
        this.stopPlayback();
        this.showSlide((this.activeIndex - 1 + this.slides.length) % this.slides.length);
      }, { signal: controller.signal });

      nextButton?.addEventListener('click', () => {
        this.stopPlayback();
        this.showSlide((this.activeIndex + 1) % this.slides.length);
      }, { signal: controller.signal });
    }

    disconnectedCallback() {
      this.connectionController?.abort();
      this.connectionController = null;
      this.visibilityObserver?.disconnect();
      this.visibilityObserver = null;
      this.stopPlayback();
    }
  }

  customElements.define('photo-slideshow', PhotoSlideshow);
</script>
