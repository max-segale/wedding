---
const rsvpData = Astro.cookies.get('rsvp')?.value || '{}';
const rsvpObj = JSON.parse(rsvpData);
const guestNames = rsvpObj.names.join(' and ');
const message = rsvpObj.attend ?
  'We are so excited for you to join us for our special day.' :
  'Sorry you cannot attend, but thanks for letting us know.';
---

<div>
  <h3>Thank You {guestNames}</h3>
  <p>{message}</p>
</div>