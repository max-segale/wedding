---
import Section from './Section.astro';
import Question from './Question.astro';

const faqItems = [
  {
    question: 'Can I bring my children to the wedding?',
    answer: 'No, we kindly ask that parents do not bring their children to the wedding ceremony or reception.',
  },
];
---

<Section id="faq">
  <h2>Frequently Asked Questions</h2>
  <ul>
    {faqItems.map(item => (
      <Question {...item} />
    ))}
  </ul>
</Section>

