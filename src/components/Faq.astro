---
import Section from './Section.astro';
import Question from './Question.astro';

const faqItems = [
  {
    question: 'What is the dress code?',
    answer: 'Formal attire is required. The ceremony site will involve walking in the grass, so plan shoes accordingly.',
  },
  {
    question: 'Will any transportation be provided?',
    answer: 'No, all events and activities for the weekend will be taking place at the Shawnee Inn. Once you arrive you can hang up your car keys for the weekend and relax.',
  },
  {
    question: "What if I can't stay at the Shawnee Inn for two nights?",
    answer: 'The Shawnee Inn has a two night minimum stay for guests on weekends. We understand that staying for two nights will not be possible for everyone, but there are plenty of other lodging options nearby. If you are staying off-site you should not have any trouble getting a taxi or Uber.',
  },
  {
    question: 'Can I bring my children to the wedding?',
    answer: 'No, we kindly ask that you do not bring your children to the ceremony or reception because they are for adults only.',
  },
  {
    question: 'Can I bring my dog to the Shawnee Inn?',
    answer: 'No, unfortunately the Shawnee Inn does not allow pets',
  }
];
---

<Section id="faq" title="Frequently Asked Questions">
  <ul class="grid">
    {faqItems.map(item => (
      <li class="item">
        <Question {...item} />
      </li>
    ))}
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }

  .item {
    padding-bottom: .5rem;

    &:not(:last-child) {
      border-bottom: .1rem solid rgb(0 0 0 / 0.1);
    }
  }
</style>