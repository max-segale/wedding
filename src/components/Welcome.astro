---
import { Image } from 'astro:assets';
import engagementPhoto from '../assets/alex-max-engagement.jpeg';
import Section from './Section.astro';
---

<Section id="welcome">
  <h1>Alexandra Lozier <span class="name-break">&amp;</span> Maxwell Segale</h1>
  <h2>September 12th 2026</h2>
  <h3>Shawnee on Delaware, PA</h3>
  <div class="photo">
    <Image class="image" src={engagementPhoto} alt="" priority />
  </div>
</Section>

<style>
  * {
    text-align: center;
  }

  .name-break {
    position: relative;
    z-index: -1;
    display: block;
    line-height: 0;
    font-size: 4.5em;
    color: #ddd;
    font-weight: 300;
  }

  .photo {
    width: 100%;
    max-width: 100rem;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    margin: 2rem auto 0;
    overflow: hidden;
  }

  .image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
