---
const { class: className, type = 'button', href, target, iconClass, label, controls, expanded, disabled } = Astro.props;
const Element = href ? 'a' : 'button';
---

<Element class:list={['btn', className]} {href} {target} type={href ? null : type} aria-label={label} aria-controls={controls} aria-expanded={expanded} {disabled}>
  {iconClass && (
    <span class:list={['icon', iconClass]}>
      <span class="line top"></span>
      {['nav', 'play'].includes(iconClass) && (<span class="line middle"></span>)}
      <span class="line bottom"></span>
    </span>
  )}
  <slot />
</Element>

<style>
  .btn {
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    flex-shrink: 0;
    background: rgb(0 0 0 / .5);
    color: #fff;
    border: 0;
    border-radius: .75rem;
    padding: .5rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    appearance: none;
    transition: transform .1s linear;

    &:active:not(:disabled) {
      transform: scale(.9);
    }

    &.large {
      padding: 1rem 2rem;
    }

    &.light {
      background: rgb(255 255 255 / .8);
      color: #000;

      .line {
        background: rgb(0 0 0 / .8);
      }
    }

    &.open {
      .icon.nav {
        .middle {
          width: 0;
        }

        .top {
          transform: rotate(45deg);
        }

        .bottom {
          transform: rotate(-45deg);
        }
      }
    }

    &.playing {
      .icon.play {
        .top {
          transform: translateX(-100%);
        }

        .middle {
          height: 0;
          margin-top: calc(var(--line-width) / 2);
          transform: translateX(-100%);
        }

        .bottom {
          transform: translateX(100%);
        }
      }
    }
  }

  .icon {
    display: grid;
    grid-template-columns: 1fr;
    place-content: center;
    width: 1.5rem;
    height: 1.5rem;
    --line-width: .25rem;

    &.nav,
    &.close,
    &.play {
      .line {
        grid-column: 1;
        grid-row: 1;
      }
    }

    &.nav {
      .line {
        transition: transform .5s ease, width 500ms ease;
      }

      .top {
        transform: translateY(-250%);
      }

      .bottom {
        transform: translateY(250%);
      }
    }

    &.close {
      .top {
        transform: rotate(45deg);
      }

      .bottom {
        transform: rotate(-45deg);
      }
    }

    &.next,
    &.prev {
      .line {
        width: 75%;
      }
    }

    &.next {
      .top {
        transform: rotate(-45deg);
        transform-origin: 100% 100%;
      }

      .bottom {
        transform: rotate(45deg);
        transform-origin: 100% 0%;
      }
    }

    &.prev {
      .top {
        transform: rotate(45deg);
        transform-origin: 0% 100%;
      }

      .bottom {
        transform: rotate(-45deg);
        transform-origin: 0% 0%;
      }
    }

    &.play {
      grid-template-rows: 1fr;

      .line {
        height: 100%;
        width: var(--line-width);;
        transition: transform .5s ease, height 500ms ease, margin-top 500ms ease;
      }

      .top {
        transform: translate(-200%, 0) rotate(-60deg);
        transform-origin: 50% calc(var(--line-width) / 2);
      }

      .middle {
        margin-top: 0;
        transform: translateX(-200%);
      }

      .bottom {
        transform: translate(-200%, 0) rotate(60deg);
        transform-origin: 50% calc(100% - calc(var(--line-width) / 2));
      }
    }
  }

  .line {
    display: block;
    width: 100%;
    height: var(--line-width);
    margin: 0 auto;
    border-radius: calc(var(--line-width) / 2);
    background: rgb(255 255 255 / .8);
    transform-origin: 50% 50%;
  }
</style>
