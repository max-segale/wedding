---
import Section from '@/components/Section.astro';
import RsvpForm from '@/components/RsvpForm.astro';
import RsvpThanks from '@/components/RsvpThanks.astro';
import { rsvpOpen } from '@/data/status';

const { primary } = Astro.props;
const rsvpData = Astro.cookies.get('rsvp')?.value;
---

<Section id="rsvp" title="RSVP" {primary}>
  {!rsvpData && (
    rsvpOpen ? (
      <p>Please fill out the form below to let us know if you will be attending our wedding. Please choose a meal option for each guest that will be attending, and let us know if you have any dietary restrictions.</p>
    ) : (
      <p>The RSVPs have been closed. We are so excited see everyone and share our special day with you!</p>
    )
  )}
  {rsvpData ? (
    <RsvpThanks />
  ) : (
    rsvpOpen && (
      <RsvpForm />
    )
  )}
</Section>
