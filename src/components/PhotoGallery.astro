---
import { Image } from 'astro:assets';
import { photoCollections, type PhotoItem } from '@/data/photos';

const { galleryItems, category } = Astro.props;
const imageFiles = photoCollections[category as keyof typeof photoCollections];
const images = await Promise.all(
  Object.values(imageFiles).map(importFn => importFn().then(module => module.default))
);
---

<div class="photo-gallery">
  {
    images.map((image, index) => {
      return (
        <button class:list={['gallery-item']} type="button" data-index={index} aria-label="View photo">
          <Image class="photo" src={image} alt="" />
        </button>
      )
    })
  }
</div>

<style>
  .photo-gallery  {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;

    @media (width >= 48rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .gallery-item {
    display: block;
    aspect-ratio: 1 / 1;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;

    &.wide,
    &.large {
      grid-column: span 2;
    }

    &.tall,
    &.large {
      grid-row: span 2;
    }

    &.wide {
      aspect-ratio: 2 / 1;
    }

    &.tall {
      aspect-ratio: 1 / 2;
    }

    &.md-tall {
      @media (width >= 48rem) {
        grid-row: span 2;
        aspect-ratio: 1 / 2;
      }
    }

    &.row {
      grid-column: span 3;
      aspect-ratio: 3 / 1;

      @media (width >= 48rem) {
        grid-column: span 2;
        aspect-ratio: 2 / 1;
      }
    }

    &.top {
      .photo {
        object-position: 50% 0;
      }
    }
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
