---

import PhotoThumbnail from '@/components/PhotoThumbnail.astro';
import { photoCollections } from '@/data/photos';

const { category } = Astro.props;
const imageImports = photoCollections[category as keyof typeof photoCollections];
const images = await Promise.all(
  Object.values(imageImports).map(importFn => importFn().then(module => module.default))
);
---

<div class="photo-gallery">
  {
    images.map((image, index) => {
      const size = image.width < image.height ? 'tall' : 'wide';
      return (
        <div class:list={['gallery-item', size]}>
          <PhotoThumbnail src={image} galleryIndex={index} {size} />
        </div>
      )
    })
  }
</div>

<style>
  .photo-gallery  {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: .5rem;

    @media (--tablet) {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (--desktop) {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .gallery-item {
    max-width: 100%;
    height: 100%;
    overflow: hidden;

    &.wide,
    &.large {
      grid-column: span 2;
    }

    &.tall,
    &.large {
      grid-row: span 2;
    }

    &.wide {
      aspect-ratio: 2 / 1;
    }

    &.tall {
      aspect-ratio: 1 / 2;
    }
  }
</style>
