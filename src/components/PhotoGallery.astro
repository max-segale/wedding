---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { PhotoItem } from '@/data/gallery';

const { photoItems } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{jpeg,jpg,png,gif}');
---

<div id="gallery" class="gallery">
  <div class="grid">
    {photoItems.map(({ file, caption, size }: PhotoItem, index: number) => {
      if (!images[`../assets/${file}`]) {
        throw new Error(`${file} not found`);
      }
      return (
        <button class:list={['gallery-item', size]} type="button" data-index={index} aria-label="View image">
          <Image class="photo" src={images[`../assets/${file}`]()} alt={caption || ''} />
        </button>
      );
    })}
  </div>
</div>

<style>
  .gallery {
    margin: 2rem 0;
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;

    @media (width >= 48rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(8, 1fr);
    }
  }

  .gallery-item {
    display: block;
    aspect-ratio: 1 / 1;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;

    &.wide,
    &.large {
      grid-column: span 2;
    }

    &.tall,
    &.large {
      grid-row: span 2;
    }

    &.wide {
      aspect-ratio: 2 / 1;
    }

    &.tall {
      aspect-ratio: 1 / 2;
    }

    &.md-tall {
      @media (width >= 48rem) {
        grid-row: span 2;
        aspect-ratio: 1 / 2;
      }
    }

    &.row {
      grid-column: span 3;
      aspect-ratio: 3 / 1;

      @media (width >= 48rem) {
        grid-column: span 2;
        aspect-ratio: 2 / 1;
      }
    }

    &.top {
      .photo {
        object-position: 50% 0;
      }
    }
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
