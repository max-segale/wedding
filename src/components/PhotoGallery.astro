---
import { Image } from 'astro:assets';
import { photoCollections, type PhotoItem } from '@/data/photos';

const { galleryItems, category } = Astro.props;
const imageFiles = photoCollections[category as keyof typeof photoCollections];
const firstImage = Object.keys(imageFiles)[0];
const imageDir = firstImage.substring(0, firstImage.lastIndexOf('/'));
let itemIndex = -1;
---

<div id="gallery" class="gallery">
  <div class="grid">
    {galleryItems.map(({ file, caption, size }: PhotoItem) => {
      const image = imageFiles[`${imageDir}/${file}`];
      if (!image) {
        console.error(`${file} not found`);
        return;
      }
      itemIndex++;
      return (
        <button class:list={['gallery-item', size]} type="button" data-index={itemIndex} aria-label="View image">
          <Image class="photo" src={image()} alt={caption || ''} />
        </button>
      );
    })}
  </div>
</div>

<style>
  .gallery {
    margin: 2rem 0;
    overflow: hidden;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-flow: dense;

    @media (width >= 48rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .gallery-item {
    display: block;
    aspect-ratio: 1 / 1;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;

    &.wide,
    &.large {
      grid-column: span 2;
    }

    &.tall,
    &.large {
      grid-row: span 2;
    }

    &.wide {
      aspect-ratio: 2 / 1;
    }

    &.tall {
      aspect-ratio: 1 / 2;
    }

    &.md-tall {
      @media (width >= 48rem) {
        grid-row: span 2;
        aspect-ratio: 1 / 2;
      }
    }

    &.row {
      grid-column: span 3;
      aspect-ratio: 3 / 1;

      @media (width >= 48rem) {
        grid-column: span 2;
        aspect-ratio: 2 / 1;
      }
    }

    &.top {
      .photo {
        object-position: 50% 0;
      }
    }
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
