---
const { class: className, label, type = 'text', required = false, showLabel, ...rest } = Astro.props;
const Wrapper = showLabel ? 'label' : Fragment;
---

<Wrapper>{showLabel && (<span>{label} {!required && (<em>Optional</em>)}</span>)}
  <input class={className} {type} {required} aria-label={!showLabel ? label : null} {...rest} />
</Wrapper>

<style>
  input {
    padding: 0;
    text-indent: .5rem;
    color: #333;

    &::placeholder {
      color: #666;
    }
  }
</style>