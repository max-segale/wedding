---
import { Image } from 'astro:assets';
import shawneeRoomPhoto from '../assets/shawnee-room.jpeg';
import shawneeGlampPhoto from '../assets/shawnee-glamping.jpeg';
import Section from './Section.astro';
---

<Section id="lodging">
  <h2>Lodging</h2>
  <div class="grid">
    <div class="info">
      <h3>The Shawnee Inn &amp; Golf Resort</h3>
      <p>We encourage guest to stay Friday and Saturday night at the Shawnee Inn, so they can have a full weekend of fun with us! Featuring historic Main Inn rooms, multi-room cottages, glamping sites, and more, The Shawnee Inn offers a wide varienty of accomodations for your stay.</p>
      <p>To make your reservation call the inn at
        <a href="tel:+15704244000">(570)424-4000</a>. Mention our wedding for 10% off your room!
      </p>
      <p>
        <em>To view all the different accomodation options visit
          <a href="https://www.shawneeinn.com/poconos-resorts" target="_blank">shawneeinn.com/poconos-resorts</a>
        </em>
      </p>
    </div>
    <div class="photo">
      <Image class="image" src={shawneeRoomPhoto} alt="Shawnee Inn room" />
    </div>
    <div class="photo">
      <Image class="image" src={shawneeGlampPhoto} alt="Shawnee Inn glamping site" />
    </div>
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .info {
    @media (width >= 48rem) {
      grid-row: span 2;
    }
  }

  .photo {
    aspect-ratio: 2 / 1;
    overflow: hidden;

    @media (width >= 48rem) {
      grid-column: 2;
    }
  }

  .image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>