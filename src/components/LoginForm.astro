---
import { actions } from 'astro:actions';
import '@/styles/form.css';
import Input from '@/components/Input.astro';

const url = new URL(Astro.request.url);
const actionResult = Astro.getActionResult(actions.login);
const next = actionResult?.data?.next ?? url.searchParams.get('next') ?? '/';
const showError = actionResult?.data?.authenticated === false
  || Boolean(actionResult?.error);
const errorMsg = `Wrong password. Please try again.`;
---

<form method="post" action={actions.login}>
  <input type="hidden" name="next" value={next} />
  {showError && <span id="password-error" class="error-msg full-width" role="alert">{errorMsg}</span>}
  <Input class="input-item full-width" name="password" type="password" label="Password" placeholder="Password" autocomplete="none" required autofocus {...showError && { 'aria-invalid': true, 'aria-describedby': 'password-error' }} />
  <button type="submit">Continue</button>
</form>

<style>
  .error-msg {
    display: block;
    font-weight: 700;
  }
</style>
