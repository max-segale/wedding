---
const { class: className, name, options, label, placeholder } = Astro.props;
---

<select class={className} {name} aria-label={label} >
  <option value="" disabled selected>{placeholder}</option>
  {options.map(([value, description]: [string, string]) => (
    <option {value}>{description}</option>
  ))}
</select>

<style>
  select {
    padding: 0 0 0 .5rem;
    color: #666;

    &[required] {
      color: #333;
    }
  }
</style>
