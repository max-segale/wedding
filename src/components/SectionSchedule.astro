---
import Section from '@/components/Section.astro';
import { scheduleItems, type ScheduleItem } from '@/data/schedule';
---

<Section id="schedule" title="Schedule">
  <p>All scheduled events for the weekend will be taking place at the Shawnee Inn.</p>
  <div class="grid">
    {scheduleItems.map(({ day, events }: ScheduleItem) => (
      <div class="day">
        <h3 class="date">{day}</h3>
        {events.map(({ name, time, description, link }) => (
          <div class="event">
            <h4><strong>{name}</strong>{time && (` at ${time}`)}</h4>
            {description && (<p>{description}</p>)}
            {link && (<p set:html={link}></p>)}
          </div>
        ))}
      </div>
    ))}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 1rem;

    @media (--tablet) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .day {
    border-left: .1rem solid rgb(0 0 0 / .2);
    padding: 0 0 0 .5rem;
  }

  .date {
    margin-top: 1rem;
  }

  .event {
    border-top: .1rem solid rgb(0 0 0 / .2);
    padding: 1rem 0 .5rem;
  }
</style>
