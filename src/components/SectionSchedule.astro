---
import Section from './Section.astro';
const schedule = [
  {
    day : 'Friday, September 11th',
    events: [
      {
        name: 'Daytime Outdoor Activies',
        description: 'If you golf, this is a great day to book a tee time. We will also be organizing a lazy river paddle board party down the Delaware. More details to come soon.',
        link: `
          <p>
            <strong>
              <a href="/activities">Learn more about the weekend activities</a>
            </strong>
          </p>
        `,
      },
      {
        name: 'Welcome Cocktails',
        time: '7:00pm',
        description: "Let's get this party started with a joyful meet and greet with all our family and friends. Location to be determined.",
      },
    ],
  },
  {
    day : 'Saturday, September 12th',
    events: [
      {
        name: 'Wedding Ceremony',
        time: '3:00pm',
        description: 'Join us on the banks of the Delaware River for a beautiful outdoor wedding ceremony.',
      },
      {
        name: 'Cocktail Hour',
        time: '4:00pm',
        description: 'Hangout under the river-side pavilion and enjoy some drinks and good vibes.',
      },
      {
        name: 'Wedding Reception',
        time: '5:30pm',
        description: 'We move the party inside to the Worthington Ballroom for dinner and dancing.',
      },
      {
        name: 'After Party',
        time: '10:00pm',
        description: 'Walk down to ShawneeCraft Brewery to keep the good times rolling. Enjoy a craft beer and lounge around the fire pits.',
      },
    ],
  },
];
---

<Section id="schedule" title="Schedule">
  <p>All scheduled events for the weekend will be taking place at the Shawnee inn.</p>
  <p><em>These event times are not finalized yet so check back once the invitaitons have been sent.</em></p>
  <div class="grid">
    {schedule.map(({ day, events }) => (
      <div class="day">
        <h3 class="date">{day}</h3>
        {events.map(({ name, time, description, link }) => (
          <div class="event">
            <h4><strong>{name}</strong>{time && (` at ${time}`)}</h4>
            {description && (<p>{description}</p>)}
            {link && (<p set:html={link}></p>)}
          </div>
        ))}
      </div>
    ))}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    gap: 1rem;

    @media (width >= 48rem) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .day {
    border-left: .1rem solid rgb(0 0 0 / .2);
    padding: 0 0 0 .5rem;
  }

  .date {
    margin-top: 1rem;
  }

  .event {
    border-top: .1rem solid rgb(0 0 0 / .2);
    padding: 1rem 0 .5rem;
  }
</style>