---
import RsvpInput from './RsvpInput.astro';
import RsvpSelect from './RsvpSelect.astro';

const { primary, ...rest } = Astro.props;
const label = `Guest ${primary ? 'One' : 'Two'}`;
const options = [
 ['steak', 'Grilled flat iron steak with carmelized onion and port wine jus'],
 ['chicken', 'Pesto-grilled chicken with bruschetta topping and balsamic glaze'],
 ['salmon', 'Cedar-roasted salmon with bacon, maple, and mustard vinaigrette'],
];
---

<fieldset>
  <legend>{label} {!primary && (<em>Optional</em>)}</legend>
  <div class="grid">
    <RsvpInput class="input-item full-width" name="names" label=`${label} Name` placeholder="First and Last Name" required={primary} autocomplete={primary ? 'name' : 'off'} {...rest} />
    <RsvpSelect class="input-item" name="meals" label=`${label} Meal` placeholder="Choose Meal" {options} {...rest} />
    <RsvpInput class="input-item" name="restrictions" label=`${label} Request` placeholder="Dietary restrictions" {...rest} />
  </div>
</fieldset>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .5rem;

    .full-width {
      grid-column: 1 / -1;
    }
  }
</style>