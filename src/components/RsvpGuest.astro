---
import Input from './Input.astro';
import Select from './Select.astro';

const { primary } = Astro.props;
const label = `Guest ${primary ? 'One' : 'Two'}`;
const options = [
 ['steak', 'Grilled flat iron steak with carmelized onion and port wine jus'],
 ['chicken', 'Pesto-grilled chicken with bruschetta topping and balsamic glaze'],
 ['salmon', 'Cedar-roasted salmon with bacon, maple, and mustard vinaigrette'],
];
---

<fieldset>
  <legend>{label} {!primary && (<em>Optional</em>)}</legend>
  <div class="grid">
    <Input class="input-item" name="names" label=`${label} Name` placeholder="First and Last Name" required={primary} pattern={primary && '\\S.*|.*\\S'} autocomplete={primary ? 'name' : 'off'} />
    <Select class="input-item" name="meals" label=`${label} Meal` placeholder="Choose Meal" {options} />
    <Input class="input-item" name="restrictions" label=`${label} Request` placeholder="Dietary restrictions" />
  </div>
</fieldset>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: .5rem;
  }
</style>