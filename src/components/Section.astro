---
const { id, title, class: className } = Astro.props;
---

<section {id} class={className}>
  <div class="container">
    {title && (<h2 class="title">{title}</h2>)}
    <slot />
    {id !== 'welcome' && id !== 'rsvp' && (
      <hr />
    )}
  </div>
  {id === 'welcome' && (
    <div class="background"></div>
  )}
</section>

<style>
  section {
    padding: 0 1rem;
    scroll-margin-top: var(--headerHeight);

    &.hero {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-flow: column nowrap;
      align-items: center;
      justify-content: center;
      min-height: 100lvh;
      background: linear-gradient(0deg, rgba(255, 0, 72, 0.2), transparent);
      text-align: center;
    }

    &.active {
      .background {
        width: 100%;
      }
    }

    &:first-child {
      padding-top: var(--headerHeight);
    }
  }

  .container {
    width: 100%;
    max-width: var(--containerWidth);
    margin: 0 auto;
    padding: 2rem 0;
  }

  .title {
    margin-bottom: 1rem;
    border-bottom: .1rem solid rgb(0 0 0 / 0.2);
    padding-bottom: .25rem;
  }

  hr {
    width: 50%;
    height: 0;
    margin: 4rem auto 0;
    border: 0;
    border-top: .1rem solid rgb(0 0 0 / .1);
  }

  .background {
    position: absolute;
    z-index: -2;
    left: 50%;
    top: 0;
    width: 250%;
    min-width: 32rem;
    height: 100%;
    transform: translateX(-50%);
    background:
      url(../assets/flowers-left.png) no-repeat 0% 50%/auto 100%,
      url(../assets/flowers-right.png) no-repeat 100% 50%/auto 100%;
    transition: width 1s ease-out;

    @media (width >= 48rem) {
      width: 175%;
    }

    @media (width >= 64rem) {
      width: 150%;
      height: 125%;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll('section');

  const observerCallback = (entries: IntersectionObserverEntry[]) => {
    entries.forEach(({ target, isIntersecting}) => {
      const navLink = document.querySelector(`nav.header a[href="#${target.id}"]`);
      target.classList.toggle('active', isIntersecting);
      navLink?.classList.toggle('active', isIntersecting);
    });
  };

  const observerOptions = {
    rootMargin: '-50% 0% -50% 0%',
    threshold: 0,
  };

  const observer = new IntersectionObserver(observerCallback, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });
</script>