---
const { id, class: className } = Astro.props;
const isHero = id === 'welcome';
const isRsvp = id === 'rsvp';
const isGallery = id ==='gallery';
---

<section {id} class={className}>
  {isGallery ? (
    <slot />
  ) : (
    <div class="container">
      <slot />
      {!isHero && !isRsvp &&  (
        <hr />
      )}
    </div>
  )}
  {isHero && (
    <div class="background"></div>
  )}
</section>

<style>
  section {
    padding: 0 1rem;
    scroll-margin-top: var(--headerHeight);

    &.hero {
      position: relative;
      overflow: hidden;
      display: flex;
      flex-flow: column nowrap;
      align-items: center;
      justify-content: center;
      min-height: 100lvh;
      padding-top: var(--headerHeight);
      background: linear-gradient(0deg, rgba(255, 0, 72, 0.2), transparent);
      text-align: center;
    }

    &.gallery {
      margin: 2rem 0;
      padding: 0;
    }
  }

  .container {
    width: 100%;
    max-width: var(--containerWidth);
    margin: 0 auto;
    padding: 2rem 0;
  }

  hr {
    margin: 4rem 3rem 0;
    height: 0;
    border: 0;
    border-top: .1rem solid rgb(0 0 0 / .1);
  }

  .background {
    position: absolute;
    z-index: -2;
    left: 50%;
    top: 0;
    width: 100%;
    min-width: 32rem;
    height: 100%;
    transform: translateX(-50%);
    background:
      url(../assets/flowers-left.png) no-repeat 0% 100%/auto 100%,
      url(../assets/flowers-right.png) no-repeat 100% 100%/auto 100%;
  }
</style>

<script>
  const sections = document.querySelectorAll('section');

  const observerCallback = (entries: IntersectionObserverEntry[]) => {
    entries.forEach(({ target, isIntersecting}) => {
      const navLink = document.querySelector(`nav.header a[href="#${target.id}"]`);
      target.classList.toggle('active', isIntersecting);
      navLink?.classList.toggle('active', isIntersecting);
    });
  };

  const observerOptions = {
    rootMargin: '-50% 0px -50% 0px',
    threshold: 0,
  };

  const observer = new IntersectionObserver(observerCallback, observerOptions);

  sections.forEach(section => {
    observer.observe(section);
  });
</script>