---
import ButtonMenu from './ButtonMenu.astro';
---

<dialog class="dialog">
  <figure class="dialog-container">
    <ButtonMenu class="close" label="Close image" />
    <div class="dialog-view">
      <img class="dialog-image" />
    </div>
    <div class="dialog-row">
      <ButtonMenu class="prev" label="Previous image" />
      <figcaption class="image-caption"></figcaption>
      <ButtonMenu class="next" label="Next image" />
    </div>
  </figure>
</dialog>

<style>
  .dialog {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    border: 0;
    padding: 1rem;
    background: transparent;
    opacity: 0;
    transition: opacity .25s linear;

    &::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition: background-color .25s linear, backdrop-filter .25s linear;
    }

    &.is-open {
      opacity: 1;

      &::backdrop {
        background: rgb(0 0 0 / .5);
        backdrop-filter: blur(.5rem);
      }
    }
  }

  .dialog-container {
    display: flex;
    flex-flow: column nowrap;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .dialog-view {
    flex: 0 1 auto;
    overflow: hidden;
  }

  .dialog-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    margin: 0 auto;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity .125s linear;

    &.is-loaded {
      opacity: 1;
    }
  }

  .dialog-row {
    width: 100%;
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .image-caption {
    color: #fff;
    text-align: center;
  }
</style>

<script>
  const dialogPhoto = document.querySelector('.dialog') as HTMLDialogElement;
  const btnClose = dialogPhoto.querySelector('button.close') as HTMLButtonElement;
  const btnPrev = dialogPhoto.querySelector('button.prev') as HTMLButtonElement;
  const btnNext = dialogPhoto.querySelector('button.next') as HTMLButtonElement;
  const dialogImage = dialogPhoto.querySelector('.dialog-image') as HTMLImageElement;
  const imageCaption = dialogPhoto.querySelector('.image-caption') as HTMLElement;
  const photoGallery = document.getElementById('gallery') as HTMLElement;
  const galleryItems = photoGallery.querySelectorAll('.gallery-item');
  let itemIndex = -1;

  const showPhoto = (callback?: () => void) => {
    const selectedItem = galleryItems[itemIndex] as HTMLElement;
    const { src, alt } = selectedItem.querySelector('img') as HTMLImageElement;
    if (dialogImage.src === src) {
      callback?.();
      return;
    };
    dialogImage.onload = callback || null;
    dialogImage.src = src;
    dialogImage.alt = alt;
    imageCaption.textContent = alt;
  }

  const selectPhoto = () => {
    showPhoto(() => {
      dialogImage.classList.add('is-loaded');
    });
    dialogPhoto.showModal();
    dialogPhoto.getBoundingClientRect();
    dialogPhoto.classList.add('is-open');
  };

  const prevItem = () => {
    itemIndex = (itemIndex - 1 + galleryItems.length) % galleryItems.length;
    showPhoto();
  };

  const nextItem = () => {
    itemIndex = (itemIndex + 1) % galleryItems.length;
    showPhoto();
  };

  btnPrev.addEventListener('click', prevItem);

  btnNext.addEventListener('click', nextItem);

  btnClose.addEventListener('click', () => {
    dialogPhoto.classList.remove('is-open');
    dialogImage.classList.remove('is-loaded');
    dialogPhoto.close();
  });

  dialogPhoto.addEventListener('keydown', ({ key }: KeyboardEvent) => {
    if (key === 'ArrowRight') nextItem();
    if (key === 'ArrowLeft') prevItem();
  });

  photoGallery.addEventListener('click', ({ target }: MouseEvent) => {
    const item = (target as HTMLElement).closest('.gallery-item') as HTMLElement;
    if (!item) return;
    itemIndex = Number(item.dataset.index || 0);
    selectPhoto();
  });
</script>