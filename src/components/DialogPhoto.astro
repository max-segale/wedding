<dialog class="dialog">
  <figure class="dialog-container">
    <button class="btn close" type="button" aria-label="Close image"></button>
    <div class="dialog-view">
      <img class="dialog-image" />
    </div>
    <div class="dialog-row">
      <button class="btn prev" type="button" aria-label="Previous image"></button>
      <figcaption class="image-caption"></figcaption>
      <button class="btn next" type="button" aria-label="Next image"></button>
    </div>
  </figure>
</dialog>

<style>
  .dialog {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    border: 0;
    padding: 1rem;
    background: transparent;
    opacity: 0;
    transition: opacity .5s linear;

    &::backdrop {
      background: rgb(0 0 0 / 0);
      backdrop-filter: blur(0);
      transition: background-color .5s linear, backdrop-filter .5s linear;
    }

    &.is-open {
      opacity: 1;

      &::backdrop {
        background: rgb(0 0 0 / .5);
        backdrop-filter: blur(.5rem);
      }
    }
  }

  .dialog-container {
    display: flex;
    flex-flow: column nowrap;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .dialog-view {
    flex: 0 1 auto;
    overflow: hidden;
  }

  .dialog-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity .5s linear;

    &.is-loaded {
      opacity: 1;
    }
  }

  .dialog-row {
    width: 100%;
    display: flex;
    flex-flow: row nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .image-caption {
    color: #fff;
    text-align: center;
  }

  .btn {
    display: grid;
    grid-template-columns: 1fr;
    place-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background: rgb(255 255 255 / .5);
    border: 0;
    border-radius: .75rem;
    padding: .5rem;
    cursor: pointer;
    transition: transform .1s linear;

    &::before,
    &::after {
      content: '';
      display: block;
      height: .25rem;
      border-radius: .125rem;
      background: rgb(0 0 0 / .8);
    }

    &.close {
      align-self: end;

      &::before,
      &::after {
        width: 100%;
        grid-column: 1;
        grid-row: 1;
        transform-origin: 50% 50%;
      }

      &::before {
        transform: rotate(45deg);
      }

      &::after {
        transform: rotate(-45deg);
      }
    }

    &.next,
    &.prev {
      &::before,
      &::after {
        width: 75%;
        margin: 0 auto;
      }
    }

    &.next {
      &::before {
        transform: rotate(-45deg);
        transform-origin: 100% 100%;
      }

      &::after {
        transform: rotate(45deg);
        transform-origin: 100% 0%;
      }
    }

    &.prev {
      &::before {
        transform: rotate(45deg);
        transform-origin: 0% 100%;
      }

      &::after {
        transform: rotate(-45deg);
        transform-origin: 0% 0%;
      }
    }

    &:active {
      transform: scale(.9);
    }
  }
</style>

<script>
  const dialogPhoto = document.querySelector('.dialog') as HTMLDialogElement;
  const btnClose = dialogPhoto.querySelector('.btn.close') as HTMLButtonElement;
  const btnPrev = dialogPhoto.querySelector('.btn.prev') as HTMLButtonElement;
  const btnNext = dialogPhoto.querySelector('.btn.next') as HTMLButtonElement;
  const dialogImage = dialogPhoto.querySelector('.dialog-image') as HTMLImageElement;
  const imageCaption = dialogPhoto.querySelector('.image-caption') as HTMLElement;
  const photoGallery = document.getElementById('gallery') as HTMLElement;
  const galleryItems = photoGallery.querySelectorAll('.gallery-item');
  let itemIndex = -1;

  const showPhoto = (callback?: () => void) => {
    const selectedItem = galleryItems[itemIndex] as HTMLElement;
    const { src, alt } = selectedItem.querySelector('img') as HTMLImageElement;
    if (dialogImage.src === src) {
      callback?.();
      return;
    };
    dialogImage.onload = callback || null;
    dialogImage.src = src;
    dialogImage.alt = alt;
    imageCaption.textContent = alt;
  }

  const selectPhoto = () => {
    showPhoto(() => {
      dialogImage.classList.add('is-loaded');
    });
    dialogPhoto.showModal();
    dialogPhoto.classList.add('is-open');
  };

  const prevItem = () => {
    itemIndex = (itemIndex - 1 + galleryItems.length) % galleryItems.length;
    showPhoto();
  };

  const nextItem = () => {
    itemIndex = (itemIndex + 1) % galleryItems.length;
    showPhoto();
  };

  btnPrev.addEventListener('click', prevItem);

  btnNext.addEventListener('click', nextItem);

  btnClose.addEventListener('click', () => {
    dialogPhoto.classList.remove('is-open');
    dialogImage.classList.remove('is-loaded');
    dialogPhoto.close();
  });

  dialogPhoto.addEventListener('keydown', ({ key }: KeyboardEvent) => {
    if (key === 'ArrowRight') nextItem();
    if (key === 'ArrowLeft') prevItem();
  });

  photoGallery.addEventListener('click', ({ target }: MouseEvent) => {
    const item = (target as HTMLElement).closest('.gallery-item') as HTMLElement;
    if (!item) return;
    itemIndex = Number(item.dataset.index || 0);
    selectPhoto();
  });
</script>