---
import MenuButton from '@/components/MenuButton.astro';

const { isMain } = Astro.props;
const navId = isMain ? 'header-nav' : 'footer-nav';
const navLabel = `${isMain ? 'Main' : 'Footer'} navigation`;
const navItems = [
  { name: 'Venue', link: '/#venue' },
  { name: 'Schedule', link: '/#schedule' },
  { name: 'Lodging', link: '/#lodging' },
  { name: 'FAQ', link: '/#faq' },
  { name: 'RSVP', link: '/rsvp' },
  { name: 'Activities', link: '/activities' },
  { name: 'Registry', link: 'https://withjoy.com/alex-and-max-sep-26/registry', external: true },
];
---

<nav id={navId} class:list={[{ header: isMain }]} aria-label={navLabel}>
  {isMain && (
    <div class="menu-btn">
      <MenuButton class="nav" label="Toggle navigation menu" controls={navId} expanded="false" />
    </div>
  )}
  <div class="menu">
    <ul>
      {navItems.map(({ name, link, external }) => (
        <li>
          <a class="nav-link" href={link} target={external ? '_blank' : null}>{name}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  ul {
    display: flex;
    flex-flow: row wrap;
    align-items: baseline;
    justify-content: center;
    gap: 1rem 2rem;
  }

  li {
    text-align: center;
  }

  a {
    color: #333;
  }

  .header {
    ul {
      gap: 1rem;
    }

    a {
      display: block;
      text-decoration: none;
      font-weight: 700;
      padding: .5rem 1rem;
      border-radius: .75rem;
      background: rgb(255 255 255 / .6);
      transition: background-color .25s linear;

      &:hover,
      &:focus,
      &:active {
        background: rgb(255 255 255 / .8);
      }

      &.active {
        background: rgb(255 255 255);
      }
    }

    @media (width < 64rem) {
      .menu {
        position: absolute;
        right: 0;
        top: 100%;
        max-height: 0;
        margin-top: .5rem;
        border-radius: 1rem;
        background: rgb(255 154 112 / .5);
        backdrop-filter: blur(.5rem);
        overflow: hidden;
        opacity: 0;
        transition: max-height .5s ease-out, opacity .5s linear;
      }

      ul {
        max-height: calc(100dvh - var(--headerHeight) - 1rem);
        padding: .5rem;
        flex-flow: column nowrap;
        align-items: stretch;
        justify-content: flex-start;
        gap: .5rem;
        overflow: auto;
      }

      li {
        text-align: left;
      }

      &.open {
        .menu {
          opacity: 1;
          max-height: calc(100dvh - var(--headerHeight) - 1rem);
        }
      }
    }

    @media (width >= 64rem) {
      .menu-btn {
        display: none;
      }
    }
  }
</style>

<script>
  const menuNav = document.querySelector('nav.header');
  const menuBtn = menuNav?.querySelector('button.nav');
  const navLinks = document.querySelectorAll('a.nav-link');

  const toggleNavMenu = (openMenu: boolean = false) => {
    menuNav?.classList.toggle('open', openMenu);
    menuBtn?.classList.toggle('open', openMenu);
    menuBtn?.setAttribute('aria-expanded', openMenu ? 'true' : 'false');
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuNav?.classList.contains('open');
    toggleNavMenu(!isOpen);
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      toggleNavMenu();
    });
  });
</script>
