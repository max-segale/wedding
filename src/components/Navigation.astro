---
const { type } = Astro.props;
const navLabel = (type ? `${type} ` : '') + 'navigation';
const isHeader = type === 'Main';
const navId = isHeader ? 'header-nav' : 'footer-nav';
const navItems = [
  //{ name: 'Our Story', link: '#about' },
  { name: 'Venue', link: '#venue' },
  { name: 'Schedule', link: '#schedule' },
  { name: 'Lodging', link: '#lodging' },
  //{ name: 'Activities', link: '#activities' },
  { name: 'FAQ', link: '#faq' },
  { name: 'RSVP', link: '#rsvp' },
  { name: 'Registry', link: 'https://withjoy.com/alex-and-max-sep-26/registry', external: true },
];
---

<nav id={navId} class:list={[{ header: isHeader }]} aria-label={navLabel}>
  {isHeader && (
    <button class="menu-btn" type="button" aria-label="Toggle navigation menu" aria-controls={navId} aria-expanded="false">
      <span class="btn-line"></span>
      <span class="btn-line"></span>
      <span class="btn-line"></span>
    </button>
  )}
  <div class="menu">
    <ul>
      {navItems.map(({ name, link, external }) => (
        <li>
          <a class="nav-link" href={link} {...external ? { target: '_blank'} : {}}>{name}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  ul {
    display: flex;
    flex-flow: row wrap;
    align-items: baseline;
    justify-content: center;
    gap: 1rem 2rem;
  }

  li {
    text-align: center;
  }

  a {
    color: #000;
  }

  .header {
    .menu-btn {
      display: none;
    }

    ul {
      gap: 1rem;
    }

    a {
      display: block;
      text-decoration: none;
      font-weight: 700;
      padding: .5rem 1rem;
      border-radius: .5rem;
      background: rgb(255 255 255 / .6);

      &:hover,
      &:focus,
      &:active {
        background: rgb(255 255 255 / .8);
      }
    }

    @media (width < 1024px) {
      .menu-btn {
        position: relative;
        display: grid;
        grid-template-columns: 1fr;
        align-items: center;
        justify-content: center;
        gap: 0;
        width: 2rem;
        height: 2rem;
        background: rgb(0 0 0 / .8);
        border: 0;
        border-radius: .25rem;
        padding: .25rem;
        cursor: pointer;
      }

      .btn-line {
        grid-column: 1;
        grid-row: 1;
        display: block;
        width: 100%;
        height: .25rem;
        margin: 0 auto;
        border-radius: .125rem;
        background: rgb(255 255 255 / .8);
        transition: transform 500ms ease, width 500ms ease;

        &:first-child {
          transform: translateY(-200%);
        }

        &:last-child {
          transform: translateY(200%);
        }
      }

      .menu {
        position: absolute;
        right: 0;
        top: 100%;
        max-height: 0;
        margin-top: .5rem;
        border-radius: .5rem;
        background: rgb(255 154 112 / .5);
        backdrop-filter: blur(2rem);
        overflow: hidden;
        opacity: 0;
        transition: max-height 500ms ease-out, opacity 500ms linear;
      }

      ul {
        max-height: calc(100dvh - var(--headerHeight) - 1rem);
        padding: .5rem;
        flex-flow: column nowrap;
        align-items: stretch;
        justify-content: flex-start;
        gap: .5rem;
        overflow: auto;
      }

      li {
        text-align: left;
      }

      &.open {
        .menu {
          opacity: 1;
          max-height: calc(100dvh - var(--headerHeight) - 1rem);
        }

        .btn-line {
          &:first-child {
            transform: rotate(45deg);
          }

          &:nth-child(2) {
            width: 0;
          }

          &:last-child {
            transform: rotate(-45deg);
          }
        }
      }
    }
  }
</style>

<script>
  const menuBtn = document.querySelector('.menu-btn');
  const menuNav = document.querySelector('nav');
  const navLinks = document.querySelectorAll('.nav-link');

  function toggleNavMenu(openMenu: boolean = false) {
    menuNav?.classList.toggle('open', openMenu);
    menuBtn?.setAttribute('aria-expanded', openMenu ? 'true' : 'false');
  }

  function handleMenuToggle({ target }: Event) {
    const isOpen = menuNav?.classList.contains('open');
    toggleNavMenu(!isOpen);
  }

  function handleNavSelect({ target }: Event) {
    toggleNavMenu();
  }

  menuBtn?.addEventListener('click', handleMenuToggle);
  navLinks?.forEach(link => {
    link.addEventListener('click', handleNavSelect);
  });
</script>