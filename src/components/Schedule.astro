---
import Section from './Section.astro';
const schedule = [
  {
    day : 'Friday, September 11th',
    events: [
      {
        name: 'River Trip',
        time: '12:00pm',
        description: 'We will be kicking off the weekend with a group float down the Delaware River.',
      },
      {
        name: 'Welcome Party',
        time: '7:00pm',
        description: 'Get the party started with familiar faces at The Gem & Keystone Tavern.',
      },
    ],
  },
  {
    day : 'Saturday, September 12th',
    events: [
      {
        name: 'Wedding Ceremony',
        time: '3:00pm',
        description: 'Join us on the banks of the Delaware River of for a beautiful outdoor wedding ceremony.',
      },
      {
        name: 'Cocktail Hour',
        time: '4:00pm',
        description: 'Hangout under the river-side pavilion and enjoy some drinks and good vibes.',
      },
      {
        name: 'Wedding Reception',
        time: '5:00pm',
        description: 'We move the party inside to the Worthington Ballroom for dinner and dancing.',
      },
      {
        name: 'After Party',
        time: '10:00pm',
        description: 'Walk down to ShawneeCraft Brewery to keep the good times rolling.',
      },
    ],
  },
];
---

<Section id="schedule">
  <h2>Schedule</h2>
  <p>All scheduled events for the weekend will be taking place at the Shawnee inn.</p>
  <p><em>These event times are not finalized yet so check back once the invitaitons have been sent.</em></p>
  {schedule.map(({ day, events }) => (
    <div class="day">
      <h3 class="date">{day}</h3>
      {events.map(({ name, time, description }) => (
        <div class="event">
          <h4><strong>{name}</strong> at {time}</h4>
          {description && (<p>{description}</p>)}
        </div>
      ))}
    </div>
  ))}
</Section>

<style>
  .day {
    border-left: 1px solid rgb(0 0 0 / 0.8);
    padding: 0 0 0 0.5rem;
  }

  .date {
    margin-top: 1rem;
  }

  .event {
    border-top: 1px solid rgb(0 0 0 / 0.2);
    padding-top: 1rem;
  }
</style>