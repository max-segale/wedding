---
const { class: className, type = 'button', label, controls, expanded } = Astro.props;
---

<button class={className} {type} aria-label={label} aria-controls={controls} aria-expanded={expanded}>
  {className === 'nav' && (<span></span>)}
</button>

<style>
  button {
    display: grid;
    grid-template-columns: 1fr;
    place-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background: rgb(255 255 255 / .5);
    border: 0;
    border-radius: .75rem;
    padding: .5rem;
    cursor: pointer;
    transition: transform .1s linear;

    span,
    &::before,
    &::after {
      content: '';
      display: block;
      width: 100%;
      height: .25rem;
      margin: 0 auto;
      border-radius: .125rem;
      background: rgb(0 0 0 / .8);
      transform-origin: 50% 50%;
    }

    &.nav,
    &.close {
      span,
      &::before,
      &::after {
        grid-column: 1;
        grid-row: 1;
      }
    }

    &.nav {
      background: rgb(0 0 0 / .5);

      span,
      &::before,
      &::after {
        background: rgb(255 255 255 / .8);
        transition: transform .5s ease, width 500ms ease;
      }

      &::before {
        transform: translateY(-250%);
      }

      &::after {
        transform: translateY(250%);
      }

      &.open {
        span {
          width: 0;
        }

        &::before {
          transform: rotate(45deg);
        }

        &::after {
          transform: rotate(-45deg);
        }
      }
    }

    &.close {
      &::before {
        transform: rotate(45deg);
      }

      &::after {
        transform: rotate(-45deg);
      }
    }

    &.next,
    &.prev {
      &::before,
      &::after {
        width: 75%;
      }
    }

    &.next {
      &::before {
        transform: rotate(-45deg);
        transform-origin: 100% 100%;
      }

      &::after {
        transform: rotate(45deg);
        transform-origin: 100% 0%;
      }
    }

    &.prev {
      &::before {
        transform: rotate(45deg);
        transform-origin: 0% 100%;
      }

      &::after {
        transform: rotate(-45deg);
        transform-origin: 0% 0%;
      }
    }

    &:active {
      transform: scale(.9);
    }
  }
</style>