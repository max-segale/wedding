---
const { class: className, type = 'button', label, controls, expanded, disabled = false } = Astro.props;
---

<button class={className} {type} aria-label={label} aria-controls={controls} aria-expanded={expanded} {disabled}>
  <span class="line top"></span>
  {['nav', 'play'].includes(className) && (<span class="line middle"></span>)}
  <span class="line bottom"></span>
</button>

<style>
  button {
    display: grid;
    grid-template-columns: 1fr;
    place-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    background: rgb(255 255 255 / .5);
    border: 0;
    border-radius: .75rem;
    padding: .5rem;
    cursor: pointer;
    transition: transform .1s linear;
    --line-width: .25rem;

    .line {
      display: block;
      width: 100%;
      height: var(--line-width);
      margin: 0 auto;
      border-radius: calc(var(--line-width) / 2);
      background: rgb(0 0 0 / .8);
      transform-origin: 50% 50%;
    }

    &.nav,
    &.close,
    &.play {
      .line {
        grid-column: 1;
        grid-row: 1;
      }
    }

    &.nav {
      background: rgb(0 0 0 / .5);

      .line {
        background: rgb(255 255 255 / .8);
        transition: transform .5s ease, width 500ms ease;
      }

      .top {
        transform: translateY(-250%);
      }

      .bottom {
        transform: translateY(250%);
      }

      &.open {
        .middle {
          width: 0;
        }

        .top {
          transform: rotate(45deg);
        }

        .bottom {
          transform: rotate(-45deg);
        }
      }
    }

    &.close {
      .top {
        transform: rotate(45deg);
      }

      .bottom {
        transform: rotate(-45deg);
      }
    }

    &.next,
    &.prev {
      .line {
        width: 75%;
      }
    }

    &.next {
      .top {
        transform: rotate(-45deg);
        transform-origin: 100% 100%;
      }

      .bottom {
        transform: rotate(45deg);
        transform-origin: 100% 0%;
      }
    }

    &.prev {
      .top {
        transform: rotate(45deg);
        transform-origin: 0% 100%;
      }

      .bottom {
        transform: rotate(-45deg);
        transform-origin: 0% 0%;
      }
    }

    &.play {
      grid-template-rows: 1fr;

      .line {
        height: 100%;
        width: var(--line-width);;
        transition: transform .5s ease, height 500ms ease;
      }

      .top {
        transform: translate(-200%, 0) rotate(-60deg);
        transform-origin: 50% calc(var(--line-width) / 2);
      }

      .middle {
        transform: translateX(-200%);
      }

      .bottom {
        transform: translate(-200%, 0) rotate(60deg);
        transform-origin: 50% calc(100% - calc(var(--line-width) / 2));
      }

      &.playing {
        .top {
          transform: translateX(-100%);
        }

        .middle {
          height: 0;
          transform: translateX(-100%);
        }

        .bottom {
          transform: translateX(100%);
        }
      }
    }

    &:active {
      transform: scale(.9);
    }
  }
</style>
