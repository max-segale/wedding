---
import { Image } from 'astro:assets';
import Section from '@/components/Section.astro';
import engagementPhoto from '@/assets/alex-max-engagement.jpeg';
---

<Section id="welcome" class="hero">
  <div>
    <h1>Alexandra Lozier <span class="name-break">&amp;</span> Maxwell Segale</h1>
  </div>
  <div>
    <h2>September 12th 2026</h2>
  </div>
  <div>
    <h3>Shawnee on Delaware, PA</h3>
  </div>
  <div class="photo">
    <Image class="image" src={engagementPhoto} alt="Engagement photo" priority />
  </div>
</Section>

<style>
  h1 {
    display: inline-block;
    border-radius: 1rem;
    padding: 0 .5rem;
    backdrop-filter: blur(2rem);
    position: relative;
    margin-bottom: 2rem;
  }

  .name-break {
    position: relative;
    z-index: -1;
    display: block;
    line-height: 0;
    font-size: 4.4em;
    color: rgb(0 0 0 / .1);
    font-weight: 300;
  }

  .photo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 24rem;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    margin: 2rem auto 0;
    overflow: hidden;
    animation: scaleIn 1s ease-out;
  }

  .image {
    width: auto;
    height: 100%;
    animation: scaleOut 1s ease-out;
  }

  @keyframes scaleIn {
    0% {
      transform: scale(0);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes scaleOut {
    0% {
      transform: scale(5);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
