---
import { actions } from 'astro:actions';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionLogin from '@/components/SectionLogin.astro';

const actionResult = Astro.getActionResult(actions.login);
if (actionResult?.data?.authenticated) {
  return Astro.redirect(actionResult.data.next);
}
---

<BaseLayout title="Enter Password">
  <SectionLogin />
</BaseLayout>
