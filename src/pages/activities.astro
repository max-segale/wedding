---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import SectionActivities from '../components/SectionActivities.astro';
import SectionGallery from '../components/SectionGallery.astro';
import Footer from '../components/Footer.astro';
import DialogPhoto from '../components/DialogPhoto.astro';
---

<Layout>
  <Header />
  <main>
    <SectionActivities />
    <SectionGallery />
  </main>
  <Footer />
  <DialogPhoto />
</Layout>

<style>
  main {
    padding-top: var(--headerHeight);
  }
</style>