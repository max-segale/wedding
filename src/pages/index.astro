---
import { IS_AFTER } from '@/data/constants';
import MainLayout from '@/layouts/MainLayout.astro';
import SectionWelcome from '@/components/SectionWelcome.astro';
import SectionThanks from '@/components/SectionThanks.astro';
import SectionVenue from '@/components/SectionVenue.astro';
import SectionSchedule from '@/components/SectionSchedule.astro';
import SectionLodging from '@/components/SectionLodging.astro';
import SectionFaq from '@/components/SectionFaq.astro';
import SectionRsvp from '@/components/SectionRsvp.astro';
---

<MainLayout>
  <SectionWelcome />
  {IS_AFTER ? (
    <SectionThanks />
  ) : (
    <SectionVenue />
    <SectionSchedule />
    <SectionLodging />
    <SectionFaq />
    <SectionRsvp />
  )}
</MainLayout>
